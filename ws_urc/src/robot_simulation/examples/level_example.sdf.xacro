<?xml version="1.0" ?>

<!-- 
  This file is meant to show how to use both xacro to create reusable blocks of code, and how to use levels in Gazebo.
  This assumes you have a basic understanding of how to use Gazebo, and are familiar with the SDF format.

  A ros2 launch file is also provided to show how to use ros2 to launch Gazebo, spawn a robot, and register it as a performer.
  This launch file can be run with:
    ros2 launch robot_simulation example_levels.launch.py

-->



<!--
  This is an xacro file!
  Ensure to expand it into a valid SDF before using it in Gazebo by running this command in the examples directory:
    xacro level_example.sdf.xacro > levelexample.sdf
  
  The above command will convert this file into a proper sdf that can be ran in Gazebo.
  Always run this command after making changes to this file!
-->


<sdf version="1.11" xmlns:xacro="http://ros.org/wiki/xacro"> <!-- xmlns stands for xml namespace, this allows use to use xacro-->
  <world name="levels_world">


  <!-- xacro macro. These are reusable blocks of code that act as templates or functions -->
    <!--
      This is a macro that creates a single plane that acts as a level. It takes in the following parameters:
        name: The name of the model
        x: The x position of the model
        y: The y position of the model
        z: The z position of the model
    -->
    <xacro:macro name="Single_level_plane_model" params="name x y z">

      <!-- This part defines the visual and collision model -->
      <model name="${name}"> <!-- ${xxxx} denotes that we are passing in a parameter. In this case, name. -->
        <pose>${x} ${y} ${z} 0 0 0</pose> <!-- See above, this passes x, y, and z into the pose -->
        <static>true</static>

        <link name="link">

          <collision name="collision">
            <geometry>
              <plane>
                <normal>0 0 1</normal>
                <size>10 10</size>
              </plane>
            </geometry>
          </collision>

          <visual name="visual">
            <geometry>
              <plane>
                <normal>0 0 1</normal>
                <size>10 10</size>
              </plane>
            </geometry>

            <material>
              <ambient>0.3 0.3 0.8 1</ambient>
              <diffuse>0.3 0.3 0.8 1</diffuse>
              <specular>0.3 0.3 0.8 1</specular>
            </material>

          </visual>

        </link>
      </model>
    </xacro:macro>

    <!-- 
      This macro defines a level. This level references an entity with the specified name. 
      The level x y z and should match its corresponding model's x y z.
      The level ignores rotation values and is always axis-aligned.
    -->
    <xacro:macro name="Single_level_plane_level" params="name x y z">
      <level name="${name}_level">

          <!-- Rotation values in pose are ignored here -->
          <pose>${x} ${y} ${z} 0 0 0</pose>

          <geometry> 
            <!-- 
              A level is surrounded by a bounding box. This tells Gazebo what space the level will occupy 
              It always must be the box geometry.
              Think of this as an invisible box, where anything inside it could be considered "inside" the level.

              The dimensions should roughly match the size of the model, with the z axis being slightly larger.
              This ensures that the performer is always considered "inside" the level when they are on top of the model.
            -->
            <box>
              <size>10 10 2</size>
            </box>
          </geometry>

          <!-- Use the <ref> tag to tell Gazebo what entity is in the level. This determines what gets loaded and unloaded -->
          <ref>${name}</ref>

          <!-- This is the buffer. This means that the level will be loaded when the performer is less than 2 meters away from the bounding box. -->
          <buffer>2</buffer> 

      </level>
    </xacro:macro>



    <!-- We'll set the performer in the launch file (robot_simulation/launch/example_levels.launch.py) -->



    <!-- Now we set up the actual world as usual -->
    <gravity>0 0 -9.81</gravity>
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>



    <!-- Now we can use the macro to create levels -->
    <!-- First, create the models -->
    <xacro:Single_level_plane_model name="level_1" x="10" y="0" z="0"/>
    <xacro:Single_level_plane_model name="level_2" x="20" y="0" z="0"/>
    <xacro:Single_level_plane_model name="level_3" x="10" y="10" z="0"/>
    <xacro:Single_level_plane_model name="level_4" x="20" y="10" z="0"/>


    <!-- Then assign those models to a level -->
    <!-- Notice that the level names match the model names -->
    <!-- Levels must be defined inside a dummy plugin, as shown -->
    <plugin name="gz::sim" filename="dummy">
      <xacro:Single_level_plane_level name="level_1" x="10" y="0" z="0"/>
      <xacro:Single_level_plane_level name="level_2" x="20" y="0" z="0"/>
      <xacro:Single_level_plane_level name="level_3" x="10" y="10" z="0"/>
      <xacro:Single_level_plane_level name="level_4" x="20" y="10" z="0"/>
    </plugin>



    <!-- Lets create a base plane that the rover can spawn in on -->
    <!-- Since the rover won't immediately be registered as a performer, it needs a place to spawn while the launch file runs -->
    <model name="base_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>